{
  "name": "guildmaster",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts start",
    "stop": "node --experimental-strip-types src/cli.ts stop",
    "status": "node --experimental-strip-types src/cli.ts status",
    "serve": "node --experimental-strip-types src/service/main.ts",
    "dev": "node --experimental-strip-types src/cli.ts dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts src/engine/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@modelcontextprotocol/client": "2.3.1",
    "@napi-rs/keyring": "2.1.0",
    "ajv": "8.20.0",
    "entities": "6.0.1",
    "marked": "18.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typebox": "1.3.32"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
